+            $r = $ctrl->r122AfterReceive($D[0], $D[1], $D[2], $D[3], $D[4], '1st', $q);
+            $check('E-01', '接続が動いた', $r['ran'], true);
+            $check('E-02', '初回を検証した（直すところがある）',
