+            $check('E-06', '送信口が呼ばれた回数は1回', count($calls), 1);
+            $this->line('      送信先 : ' . $sentTo());
+            $check('E-07', '1st の送信先は Anthropic', $sentTo(), 'Anthropic');
+            $check('E-08', '訂正の枠が RECEIVED になった',
