+                    ->where('role',$role)->where('attempt_no',$attemptNo)->lockForUpdate()->first();
+                if ($slot === null || $slot->status !== BaganrikiWorker::RESERVED) { return $refused; }
+                $saved = $slot->w2_send_proof ?? null;
