+    /** Use the same W2 entry for the first request and its one authorized correction. */
+    public function sendReservedW2Request(int $snapshotId, string $role, int $attemptNo, string $token,
+            \App\Services\Baganriki\FrozenInputW2 $frozen, array $prepared, int $timeout): array
+    {
+        $stage = self::stagePreparedW2Request($snapshotId,$role,$attemptNo,$token,$frozen,$prepared);
