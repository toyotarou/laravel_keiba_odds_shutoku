{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "source_ref": {
        "type": "string",
        "minLength": 1
      },
      "race_id": {
        "type": "string",
        "minLength": 1
      },
      "value": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "scope": {
        "enum": [
          "HORSE",
          "PAIR",
          "RACE",
          "COHORT"
        ]
      },
      "horse_nos": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true
      },
      "applicable_horse_nos": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true
      },
      "field": {
        "type": "string",
        "minLength": 1
      },
      "unit": {
        "type": "string",
        "minLength": 1
      },
      "slot_offset": {
        "enum": [
          21,
          18,
          15,
          12,
          9,
          6,
          null
        ]
      },
      "observed_at": {
        "type": "string",
        "format": "date-time"
      },
      "available_at": {
        "type": "string",
        "format": "date-time"
      },
      "computed_at": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "source_kind": {
        "enum": [
          "OBSERVED",
          "DERIVED"
        ]
      },
      "parents": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "formula_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "formula_version": {
        "type": [
          "string",
          "null"
        ]
      },
      "dependency_key": {
        "type": "string",
        "minLength": 1
      },
      "dependency_role": {
        "enum": [
          "SIGNAL",
          "CONTEXT"
        ]
      }
    },
    "required": [
      "source_ref",
      "race_id",
      "value",
      "scope",
      "horse_nos",
      "applicable_horse_nos",
      "field",
      "unit",
      "slot_offset",
      "observed_at",
      "available_at",
      "computed_at",
      "source_kind",
      "parents",
      "formula_id",
      "formula_version",
      "dependency_key",
      "dependency_role"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "scope": {
              "const": "HORSE"
            }
          }
        },
        "then": {
          "properties": {
            "horse_nos": {
              "minItems": 1,
              "maxItems": 1
            },
            "applicable_horse_nos": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "scope": {
              "const": "PAIR"
            }
          }
        },
        "then": {
          "properties": {
            "horse_nos": {
              "minItems": 2,
              "maxItems": 2
            },
            "applicable_horse_nos": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "scope": {
              "const": "RACE"
            }
          }
        },
        "then": {
          "properties": {
            "horse_nos": {
              "maxItems": 0
            },
            "applicable_horse_nos": {
              "maxItems": 0
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "scope": {
              "const": "COHORT"
            }
          }
        },
        "then": {
          "properties": {
            "horse_nos": {
              "maxItems": 0
            },
            "applicable_horse_nos": {
              "minItems": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "source_kind": {
              "const": "OBSERVED"
            }
          }
        },
        "then": {
          "properties": {
            "parents": {
              "maxItems": 0
            },
            "formula_id": {
              "type": "null"
            },
            "formula_version": {
              "type": "null"
            },
            "computed_at": {
              "type": "null"
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "source_kind": {
              "const": "DERIVED"
            }
          }
        },
        "then": {
          "properties": {
            "parents": {
              "minItems": 1
            },
            "formula_id": {
              "type": "string",
              "minLength": 1
            },
            "formula_version": {
              "type": "string",
              "minLength": 1
            },
            "computed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    ]
  }
}
