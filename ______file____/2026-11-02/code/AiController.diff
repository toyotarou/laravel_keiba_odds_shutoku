+    /** 発走時刻（日本時間）をマイクロ秒で。読めなければ null */
+    public static function predictionAnchorUs(string $date, string $st): ?int
+    {
+        $st = trim($st);
+        if (!preg_match('/^\d{1,2}:\d{2}(?::\d{2})?$/', $st)) { return null; }
+        if (strlen($st) <= 5) { $st .= ':00'; }
+        if (strlen($st) === 7) { $st = '0' . $st; }
+        return BaganrikiTime::us($date . 'T' . $st . '+09:00');
+    }
+
+    /**
+     * 新しい予想を出せないレース。旧方式の保存済みがあれば、それを旧方式の保存済みの返し方で見せます。
+     *   'first' / 'second' が null の側は、呼び出し側が旧方式の処理へ進みます（保存済みを返すだけ）。
+     *   保存済みが無い側は undetermined で返し、旧方式のAIは呼びません
+     *   （2nd は統合結果まで保存済みのときだけ旧方式へ。1stだけ保存済みで2ndへ進むと DeepSeek を呼ぶため）。
+     */
+    private static function predictionLegacySavedOrUndetermined($date, $kaisuu, $basho, $day, $race, string $reason): array
+    {
+        $und = self::predictionUndetermined($date, $kaisuu, $basho, $day, $race, $reason);
+        $has1 = \DB::table('t_horse_odds_finder_ai_analysis')
+                  ->where('date', $date)->where('kaisuu', $kaisuu)->where('basho_code', $basho)
+                  ->where('day', $day)->where('race', $race)->exists();
+        if (!$has1) { return $und; }
+        $hasMerge = \DB::table('t_horse_odds_finder_ai_analysis2')
+                      ->where('date', $date)->where('kaisuu', $kaisuu)->where('basho_code', $basho)
+                      ->where('day', $day)->where('race', $race)->exists()
+                 && \DB::table('t_horse_odds_finder_ai_merge_result')
+                      ->where('date', $date)->where('kaisuu', (int) $kaisuu)->where('basho_code', $basho)
+                      ->where('day', (int) $day)->where('race', (int) $race)->exists();
+        return ['state' => 'LEGACY_SAVED', 'first' => null, 'second' => $hasMerge ? null : $und['second']];
+    }
+
+    /**
+     * 凍結できなかったレースを旧方式に切り替えてよいか。切り替えるなら予算を押さえて記録し、true。
+     *   ・すでに切り替えを記録したレース → true
+     *   ・凍結の時刻から30秒たっていない／発走180秒前を過ぎた → false
+     *   ・旧方式の1st・2ndの見積り額を予算から押さえられない → false
+     */
+    private function predictionLegacyFallback(string $raceId, ?int $anchor, int $now): bool
+    {
+        $done = static fn() => \DB::table('baganriki_audit_events')
+                    ->where('race_id', $raceId)->where('kind', self::PREDICTION_FALLBACK_KIND)->exists();
+        if ($done()) { return true; }
+        if ($anchor === null) { return false; }
+        if ($now < BaganrikiTime::inputFreeze($anchor) + self::PREDICTION_FALLBACK_AFTER_FREEZE_SEC * 1000000) { return false; }
+        if ($now > $anchor - self::PREDICTION_FALLBACK_LAST_SEC * 1000000) { return false; }
+
+        $lockName = 'prediction_fallback_' . substr(hash('sha256', $raceId), 0, 32);
+        $got = \DB::select('SELECT GET_LOCK(?, 5) AS l', [$lockName]);
+        if ((int) ($got[0]->l ?? 0) !== 1) { return false; }
+        try {
+            if ($done()) { return true; }
+            $b1 = self::budgetReserve('1st', 'claude-haiku-4-5', $raceId,
+                                      self::PREDICTION_FALLBACK_BYTES, self::PREDICTION_FALLBACK_OUT_1ST);
+            if (!($b1['ok'] ?? false)) {
+                \Log::error('[PREDICTION-PUBLIC] 予算が足りないので旧方式に切り替えません',
+                    ['race_id' => $raceId, 'reason' => $b1['reason'] ?? null]);
+                return false;
+            }
+            // 旧方式の2nd（deepseek-chat）は料金表に無いので、同じ単価の deepseek-flash で見積もります
+            $b2 = self::budgetReserve('2nd', 'deepseek-flash', $raceId,
+                                      self::PREDICTION_FALLBACK_BYTES, self::PREDICTION_FALLBACK_OUT_2ND);
+            if (!($b2['ok'] ?? false)) {
+                self::budgetRelease($b1['hold'] ?? null, $raceId, '2nd の予算が足りないので旧方式に切り替えませんでした');
+                \Log::error('[PREDICTION-PUBLIC] 予算が足りないので旧方式に切り替えません',
+                    ['race_id' => $raceId, 'reason' => $b2['reason'] ?? null]);
+                return false;
+            }
+            try {
+            \DB::table('baganriki_audit_events')->insert([
+                'race_id' => $raceId, 'snapshot_id' => null, 'kind' => self::PREDICTION_FALLBACK_KIND,
+                'happened_at' => BaganrikiWorker::toDb($now), 'old_revision' => null, 'new_revision' => null,
+                'diagnostics' => json_encode([
+                    'reason' => '凍結の時刻から' . self::PREDICTION_FALLBACK_AFTER_FREEZE_SEC . '秒たっても凍結入力が無いので旧方式に切り替えます',
+                    'budget_hold_1st' => $b1['hold'] ?? null, 'budget_hold_2nd' => $b2['hold'] ?? null,
+                    'worst_usd' => round((float) ($b1['worst'] ?? 0) + (float) ($b2['worst'] ?? 0), 6),
+                    'anchor_at' => BaganrikiTime::toJst($anchor),
+                ], JSON_UNESCAPED_UNICODE),
+                'related_id' => $raceId,
+            ]);
+            } catch (\Throwable $e) {
+                // 記録できなければ切り替えません。押さえた予算も返します（次のアクセスで二重に押さえないため）
+                self::budgetRelease($b1['hold'] ?? null, $raceId, '切り替えを記録できなかったので返しました');
+                self::budgetRelease($b2['hold'] ?? null, $raceId, '切り替えを記録できなかったので返しました');
+                throw $e;
+            }
+            \Log::error('[PREDICTION-PUBLIC] 凍結できなかったので旧方式に切り替えました', ['race_id' => $raceId]);
+            return true;
+        } finally {
+            \DB::select('SELECT RELEASE_LOCK(?) AS l', [$lockName]);
+        }
+    }
+
+    private static function predictionNotReady($date, $kaisuu, $basho, $day, $race, string $why): array
+    {
+        $base = ['date' => $date, 'kaisuu' => $kaisuu, 'basho_code' => $basho, 'day' => $day,
+                 'race' => $race, 'analysis_text' => '', 'not_ready' => true,
+                 'prediction_method' => 'new', 'prediction_state' => $why];
+        return ['state' => $why, 'first' => $base, 'second' => $base];
+    }
+
+    private static function predictionUndetermined($date, $kaisuu, $basho, $day, $race, string $reason): array
+    {
+        $base = ['date' => $date, 'kaisuu' => $kaisuu, 'basho_code' => $basho, 'day' => $day,
+                 'race' => $race, 'analysis_text' => '',
+                 'prediction_method' => 'new', 'prediction_state' => 'UNAVAILABLE'];
+        return ['state' => 'UNAVAILABLE', 'first' => $base,
+                'second' => $base + ['merged_horses' => [], 'upset_race' => null, 'upset_race_status' => '不明',
+                                     'status' => 'undetermined', 'status_reason' => $reason]];
+    }
+
+    /** 公開済みの予想から、今の画面の形を作ります */
+    // private function predictionPublishedAnswer(object $snap, object $pub, array $cancelled,   // 旧（20261102 公開が無いときも補充で頭数をそろえるため ?object に）
+    private function predictionPublishedAnswer(object $snap, ?object $pub, array $cancelled,
+                                               $date, $kaisuu, $basho, $day, $race): array
+    {
+        $full = \DB::table('baganriki_snapshots')->where('id', $snap->id)->first(['input_json_1st', 'quota_1st']);
+        $in = json_decode((string) ($full->input_json_1st ?? ''), true);
+        $in = is_array($in) ? $in : [];
+        $reg = (array) ($in['source_registry'] ?? []);
+        $pop = [];
+        foreach ((array) ($in['runners'] ?? []) as $r) {
+            if (isset($r['horse_no'])) { $pop[(int) $r['horse_no']] = $r['win_rank'] ?? null; }
