+                if ($o !== null) { $osCnt[$f][$sk][$o] = ($osCnt[$f][$sk][$o] ?? 0) + 1; }
+                if ($a !== null) { $asCnt[$f][$sk][$a] = ($asCnt[$f][$sk][$a] ?? 0) + 1; }
