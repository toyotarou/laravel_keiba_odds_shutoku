+    /** 出典一覧の数値（無い・数値でなければ null） */
+    private static function predictionRegNum(array $reg, string $ref): ?float
+    {
+        $v = $reg[$ref]['value'] ?? null;
+        return is_numeric($v) ? (float) $v : null;
+    }
