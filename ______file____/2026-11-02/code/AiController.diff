+    /** 選出理由（凍結した入力の値と、確かめた根拠の系統だけで作る決まった形の文） */
+    public static function predictionReason(array $reg, int $no, array $families): string
+    {
+        $parts = [];
+        $labels = [];
+        foreach (array_keys(self::PREDICTION_FAMILY_LABEL) as $f) {
+            if (in_array($f, $families, true)) { $labels[] = self::PREDICTION_FAMILY_LABEL[$f]; }
+        }
+        if ($labels !== []) {
+            $parts[] = '確かめた根拠：' . implode('、', $labels) . '（' . count($labels) . '系統）';
+        }
+        $fmt = static fn(?float $v) => ($v === null) ? null : sprintf('%.1f', $v);
+        $w6  = $fmt(self::predictionRegNum($reg, 'h' . $no . '_win_odds_6'));
+        $w21 = $fmt(self::predictionRegNum($reg, 'h' . $no . '_win_odds_21'));
+        if ($w6 !== null) {
+            $parts[] = '6分前の単勝 ' . $w6 . '倍' . ($w21 !== null ? '（21分前 ' . $w21 . '倍）' : '');
+        }
+        $p1 = $fmt(self::predictionRegNum($reg, 'h' . $no . '_place_min_6'));
+        $p2 = $fmt(self::predictionRegNum($reg, 'h' . $no . '_place_max_6'));
+        if ($p1 !== null && $p2 !== null) { $parts[] = '複勝 ' . $p1 . '〜' . $p2 . '倍'; }
+        $fin = [];
+        for ($i = 1; $i <= 3; $i++) {
+            $v = $reg['h' . $no . '_past_finish_' . $i]['value'] ?? null;
+            if (is_numeric($v)) { $fin[] = ((int) $v) . '着'; }
+        }
+        if ($fin !== []) { $parts[] = '近' . count($fin) . '走 ' . implode('・', $fin); }
+        return ($parts === []) ? '' : implode('。', $parts) . '。';
+    }
