+        foreach ($oCnt as $f => $c) { $k = $top($c); if ($k !== null) { $auto[$f]['o'] = (int) $k; } }
+        foreach ($osCnt as $f => $bySlot) {
+            foreach ($bySlot as $sk => $c) { $k = $top($c); if ($k !== null) { $auto[$f]['os'][$sk] = (int) $k; } }
+        }
+        foreach ($asCnt as $f => $bySlot) {
