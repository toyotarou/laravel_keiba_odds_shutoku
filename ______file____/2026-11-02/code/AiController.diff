+                if (($v['display_label'] ?? null) === (string) $k) { unset($v['display_label']); }
+                foreach (['maximum', 'minimum'] as $mk) { if (array_key_exists($mk, $v) && $v[$mk] === null) { unset($v[$mk]); } }
